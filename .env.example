# Kopier denne filen til .env.local og fyll inn nøklene.
# .env.local blir aldri lastet opp til GitHub (den står i .gitignore).
# Nøklene brukes bare av server-funksjonen i src/app/api/, ikke av selve appen.

# Tale-til-tekst. Lag nøkkel på https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AI-tilbakemelding. Lag nøkkel på https://platform.claude.com (API keys).
# Uten denne får du fortsatt det du sa som tekst, med enkel tilbakemelding fra appen.
ANTHROPIC_API_KEY=
